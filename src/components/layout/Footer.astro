---
// Footer Component
import SocialLinks from '../ui/SocialLinks.astro';
---

<footer class="footer">
  <div class="footer-main">
    <div class="footer-container">
      <!-- Top Section -->
      <div class="footer-grid">
        <!-- Brand Column -->
        <div class="footer-brand">
          <div class="brand-logo">
            <img src="/logo.svg" alt="Kwan Um Zen" class="logo-image" width="40" height="40" loading="lazy" />
            <span class="brand-name">Kwan Um Zen</span>
          </div>
          <p class="brand-tagline">
            Tradícia kórejského zenu na Slovensku
          </p>
          <SocialLinks variant="badge" />
        </div>

        <!-- Quick Links -->
        <div class="footer-column">
          <h3 class="column-title">Navigácia</h3>
          <ul class="footer-links">
            <li><a href="#hero">Domov</a></li>
            <li><a href="#what-is-zen">Čo je Zen</a></li>
            <li><a href="#practice-info">Prax</a></li>
            <li><a href="#lineage">O nás</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#connect">Kontakt</a></li>
          </ul>
        </div>

        <!-- Resources -->
        <div class="footer-column">
          <h3 class="column-title">Zdroje</h3>
          <ul class="footer-links">
            <li>
              <a href="https://kwanumzen.eu" target="_blank" rel="noopener">
                Kwan Um Europe
                <svg class="external-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
                  <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.kwanumzen.org" target="_blank" rel="noopener">
                Kwan Um School of Zen
                <svg class="external-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
                  <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.kwanumzenonline.org" target="_blank" rel="noopener">
                Online Zen
                <svg class="external-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
                  <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
                </svg>
              </a>
            </li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div class="footer-column">
          <h3 class="column-title">Kontakt</h3>
          <ul class="footer-contact">
            <li>
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <a href="mailto:info@kwanumzen.sk">info@kwanumzen.sk</a>
            </li>
            <li>
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Košice, Bratislava, Piešťany, Liptovský Mikuláš, Malacky</span>
            </li>
          </ul>

          <!-- Newsletter Mini -->
          <div class="footer-newsletter">
            <p class="newsletter-label">Dostávajte informácie</p>
            <a href="#connect" class="newsletter-link">
              Pripojiť sa
              <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="footer-container">
      <div class="bottom-content">
        <div class="copyright">
          © 2025 Kwan Um Zen Slovensko. Všetky práva vyhradené.
        </div>
        <div class="bottom-links">
          <div class="language-switch">
            <span class="lang-active">SK</span>
            <span class="separator">|</span>
            <span class="lang-inactive">EN</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-slate-800);
    color: var(--color-slate-300);
  }

  .footer-main {
    padding: var(--spacing-16) 0 var(--spacing-8);
    border-bottom: 1px solid var(--color-slate-800);
  }

  .footer-container {
    max-width: 75rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Grid Layout */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
      gap: 4rem;
    }
  }

  /* Brand Column */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-image {
    height: 2.5rem;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .brand-name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-inverse);
    letter-spacing: var(--letter-spacing-wider);
  }

  .brand-tagline {
    font-size: var(--font-size-sm);
    color: var(--color-slate-400);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-relaxed);
    max-width: 18rem;
  }

  /* Footer Columns */
  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }

  .column-title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-widest);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: #a8a29e;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 300;
    position: relative;
    padding-left: 0;
  }

  .footer-links a::before {
    content: '→';
    position: absolute;
    left: -1rem;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .footer-links a:hover {
    color: #fafaf9;
    padding-left: 1.25rem;
  }

  .footer-links a:hover::before {
    opacity: 1;
    left: 0;
  }

  .external-icon {
    width: 1rem;
    height: 1rem;
    opacity: 0.5;
  }

  /* Contact Info */
  .footer-contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: #a8a29e;
    font-weight: 300;
  }

  .contact-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #78716c;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .footer-contact a {
    color: #a8a29e;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-contact a:hover {
    color: #fafaf9;
  }

  /* Newsletter Mini */
  .footer-newsletter {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #292524;
  }

  .newsletter-label {
    font-size: 0.875rem;
    color: #78716c;
    margin-bottom: 0.5rem;
  }

  .newsletter-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fafaf9;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .newsletter-link svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s ease;
  }

  .newsletter-link:hover {
    color: #e7e5e4;
  }

  .newsletter-link:hover svg {
    transform: translateX(4px);
  }

  /* Bottom Bar */
  .footer-bottom {
    padding: 1.5rem 0;
  }

  .bottom-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .bottom-content {
      flex-direction: row;
    }
  }

  .copyright {
    color: #78716c;
    font-weight: 300;
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #78716c;
  }

  .bottom-links a {
    color: #a8a29e;
    text-decoration: none;
    transition: color 0.2s ease;
    font-weight: 300;
  }

  .bottom-links a:hover {
    color: #fafaf9;
  }

  .separator {
    color: #44403c;
  }

  .language-switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-active {
    color: #fafaf9;
    font-weight: 500;
  }

  .lang-inactive {
    color: #57534e;
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Mobile Adjustments */
  @media (max-width: 639px) {
    .footer-main {
      padding: 3rem 0 1.5rem;
    }

    .footer-grid {
      gap: 2rem;
    }
  }
</style>
